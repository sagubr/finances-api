NODE_ENV=development
HOST=0.0.0.0
PORT=3005
LOG_LEVEL=info
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=finances
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DB_SSL_MODE=disabled
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
COOKIE_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
AUTH_AUTO_CONFIRM_EMAIL=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3005/api/v1/auth/callback/google
WEB_APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Nummo <no-reply@example.com>
EMAIL_REPLY_TO=
REDIS_URL=redis://localhost:6379/0
IMPORT_STORAGE_DIR=/tmp/finances-imports
EXPORT_STORAGE_DIR=/tmp/finances-exports
CORS_ALLOWED_ORIGINS=http://localhost:3000
